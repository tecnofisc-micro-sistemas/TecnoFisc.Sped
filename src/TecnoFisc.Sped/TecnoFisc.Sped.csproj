<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Pacote guarda-chuva da família TecnoFisc.Sped. Agrega EFD Contribuições, EFD ICMS-IPI, ECD e ECF via TecnoFisc.Sped.Txt; o guarda-chuva XML será incorporado após o CT-e.</Description>
    <PackageId>TecnoFisc.Sped</PackageId>
    <PackageTags>sped;fiscal;brasil;tecnofisc;efd-contribuicoes;efd-icms-ipi;ecd;ecf</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Metapacote sem código: não há .pdb, então não gerar .snupkg (o symbol server rejeita pacote vazio com 400). -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TecnoFisc.Sped.Txt\TecnoFisc.Sped.Txt.csproj" />
  </ItemGroup>

</Project>
