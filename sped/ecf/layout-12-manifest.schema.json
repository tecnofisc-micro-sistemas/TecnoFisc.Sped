{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tecnofisc.com.br/schemas/sped/ecf/layout-12-manifest.schema.json",
  "title": "ECF Layout 12 structural manifest",
  "type": "array",
  "minItems": 180,
  "maxItems": 180,
  "uniqueItems": true,
  "items": {
    "$ref": "#/$defs/record"
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "block",
        "title",
        "pageStart",
        "pageEnd",
        "level",
        "occurrence",
        "fields",
        "reviewed"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9A-Z]{4}$"
        },
        "block": {
          "type": "string",
          "enum": ["0", "C", "E", "J", "K", "L", "M", "N", "P", "Q", "T", "U", "V", "W", "X", "Y", "9"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pageStart": {
          "type": "integer",
          "minimum": 1
        },
        "pageEnd": {
          "type": "integer",
          "minimum": 1
        },
        "level": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "occurrence": {
          "type": "string",
          "pattern": "^[01]:(?:[1-9][0-9]*|N)$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "reviewed": {
          "const": true
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "description",
        "type",
        "size",
        "decimals",
        "required",
        "validValues"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["C", "N", "NS", "D"]
        },
        "size": {
          "type": "string"
        },
        "decimals": {
          "type": "string"
        },
        "required": {
          "type": "string"
        },
        "validValues": {
          "type": "string"
        }
      }
    }
  }
}
