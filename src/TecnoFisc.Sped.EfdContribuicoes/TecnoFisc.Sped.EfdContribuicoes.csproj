<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Implementação .NET do layout EFD Contribuições (PIS/COFINS) — leitura, escrita e modelo tipado dos registros publicados pela Receita Federal.</Description>
    <PackageId>TecnoFisc.Sped.EfdContribuicoes</PackageId>
    <PackageTags>sped;efd-contribuicoes;pis;cofins;fiscal;brasil;tecnofisc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TecnoFisc.Sped.Core\TecnoFisc.Sped.Core.csproj" />
    <ProjectReference Include="..\TecnoFisc.Sped.Txt.Engine\TecnoFisc.Sped.Txt.Engine.csproj" />

    <!-- Source generator referenciado como Analyzer: emite o catálogo estático em compile-time
         e não embarca no runtime do consumidor (ReferenceOutputAssembly=false). -->
    <ProjectReference Include="..\TecnoFisc.Sped.Txt.Engine.SourceGenerators\TecnoFisc.Sped.Txt.Engine.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
