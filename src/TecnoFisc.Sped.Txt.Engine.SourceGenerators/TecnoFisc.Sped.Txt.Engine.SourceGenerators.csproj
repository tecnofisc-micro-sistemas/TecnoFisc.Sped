<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source generators (Roslyn IIncrementalGenerator) que produzem catálogos estáticos de registros SPED em tempo de compilação. Referenciado como Analyzer pelos projetos de leiaute, não vai como dependência runtime.</Description>
    <PackageId>TecnoFisc.Sped.Txt.Engine.SourceGenerators</PackageId>
    <PackageTags>sped;sourcegenerator;roslyn;analyzer;tecnofisc</PackageTags>

    <!-- Source generators precisam ser netstandard2.0 (Roslyn host). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Source generator é dev-time only — não embarca runtime. Packaging consolidado vira via
         analyzers/dotnet/cs/ dentro do .nupkg de cada leiaute (futuro), por enquanto fica solto. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Sem ImplicitUsings: source gen escreve `using` explícito na saída. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
